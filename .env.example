# Schwab API (required — get from developer.schwab.com)
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1        # must match the redirect URI registered at developer.schwab.com
SCHWAB_ACCOUNT_HASH=your_account_hash_here

# Discord (required — get from discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here      # right-click channel → Copy Channel ID (Developer Mode must be on)

# Analyst provider — choose one of two paths:
#
# Path A — Claude only (legacy): set ANTHROPIC_API_KEY; leave ANALYST_* lines blank or omit them.
ANTHROPIC_API_KEY=your_anthropic_key_here    # optional if using Path B
#
# Path B — multi-provider: set ANALYST_PROVIDER + ANALYST_API_KEY; ANTHROPIC_API_KEY not required.
ANALYST_PROVIDER=claude                      # claude | gemini | openai | github  (default: claude)
ANALYST_API_KEY=                             # required for gemini/openai/github; optional when ANALYST_PROVIDER=claude
ANALYST_MODEL=                               # optional — e.g. gemini-2.5-flash for Gemini free tier
#
# Optional fallback analyst — used when the primary fails (quota exhausted, rate limit, etc.)
# Recommended: GitHub Models (free GPT-4o-mini, 128k context; requires a GitHub PAT with models:read scope)
# ANALYST_FALLBACK_PROVIDER=github
# ANALYST_FALLBACK_API_KEY=your_github_pat
# ANALYST_FALLBACK_MODEL=                   # optional — defaults to gpt-4o-mini for github provider
#
# Optional second fallback analyst — used when both primary and first fallback fail.
# DeepSeek offers an OpenAI-compatible API; deepseek-chat is the default model.
# ANALYST_FALLBACK2_PROVIDER=deepseek
# ANALYST_FALLBACK2_API_KEY=sk-...
# ANALYST_FALLBACK2_MODEL=                  # optional — defaults to deepseek-chat

# Screener thresholds (optional — shown with defaults)
MIN_DIVIDEND_YIELD=0.02
MAX_PE_RATIO=35.0
MIN_EARNINGS_GROWTH=0.05
MAX_RSI=70.0
SELL_RSI_THRESHOLD=70.0                      # RSI above this on an open position triggers sell analysis (per D-02)
MIN_VOLUME_RATIO=0.5                         # current day volume / 20-day avg must meet or exceed this
ETF_MAX_EXPENSE_RATIO=0.005                  # ETFs with netExpenseRatio above this are flagged "⚠️ (High)" in Discord (display-only, per Phase 12 D-09)
ANALYST_DAILY_LIMIT=18                       # Max analyst API calls per day across buy+sell passes (per D-11; Gemini free tier = 20 RPD)

# Trade sizing (optional)
MAX_POSITION_SIZE_USD=500.0          # max USD spent per individual trade
MAX_PORTFOLIO_USD=20000.0            # total portfolio exposure ceiling; Approve is blocked if adding this trade would exceed it

# Scheduler — single daily scan (optional; 24-hour format)
SCAN_HOUR=9
SCAN_MINUTE=0
# SCAN_TIMES=09:00,13:00                     # optional: comma-separated HH:MM overrides SCAN_HOUR/SCAN_MINUTE
# SCAN_TIMEZONE=America/New_York             # optional IANA timezone for scan times (DST-proof market alignment); empty = machine-local
ETF_SCAN_HOUR=9                              # ETF scan hour (24-hour format); defaults to 09 (per Phase 12 D-01)
ETF_SCAN_MINUTE=30                           # ETF scan minute; defaults to 30 (30-minute offset from stock scan to avoid yfinance rate-limit contention)

# S&P 500 universe (optional)
TOP_SP500_COUNT=10                           # top N S&P 500 tickers by EPS+ROE score added to each scan
ANALYST_CALL_DELAY_S=12.0                    # seconds between analyst API calls (enforces <=5 RPM on free tier)

# Safety flags (optional — set to false only when ready for live trading)
DRY_RUN=true                                 # when true, Approve button logs the order instead of placing it
PAPER_TRADING=true                           # when true, Schwab paper trading endpoint is used

# Kill switch. TRADING_ENABLED seeds the switch ONLY on a database that has
# never been written; after that the persisted state wins, so a restart cannot
# undo a /halt. Default false means a new deployment must be armed deliberately
# with /resume.
TRADING_ENABLED=false
# Comma-separated Discord user IDs allowed to run /halt and /resume. Empty
# means nobody — both directions are guarded, because leaving /resume open
# would let anyone clear a halt mid-incident.
OPS_USER_IDS=

# Sell pricing. Sells are marketable LIMIT orders priced THROUGH the bid by
# this percentage — it bounds how bad the fill may be, not whether it happens.
# Buys keep a passive quote*(1+buffer) limit; the asymmetry is deliberate.
APPROVAL_SLIPPAGE_BUFFER_PCT=0.5
# A quote older than this is refused rather than priced against. There is no
# market-order fallback: no usable quote means no sell. Enforced during REGULAR
# HOURS only — after hours the last close is the only quote there is, and a
# 30-second rule would reject every pre-open approval.
QUOTE_MAX_AGE_S=30

# Approval preflight guards (risk/preflight.py).
# Who may APPROVE a trade. Deliberately separate from OPS_USER_IDS: halting is a
# safety action anyone trusted should be able to take; spending money is not.
# Empty means nobody — never everybody.
ALLOWED_DISCORD_USER_IDS=
# 0 disables the guild check (a bot living in exactly one server).
DISCORD_GUILD_ID=0
# How far the market may have moved since the scan before approval is refused.
# The analyst reasoned about the scan price; past this the recommendation is
# about a different security than the one you would be buying.
APPROVAL_PRICE_TOLERANCE_PCT=2.0
# Ceiling on committed buy notional per TRADING SESSION — bucketed by the
# session an order will EXECUTE in, not the one it was entered in, so a
# Friday-night order and a Monday order share Monday's single allowance.
MAX_DAILY_NOTIONAL_USD=2000.0

# --- Ambiguous submissions (/resolve) ---
# How many hours an unresolved order may sit before every scan starts alerting.
# Guard 11 blocks new orders for its ticker the whole time and only a human
# running /resolve can clear it, so this alert is the only thing between an
# ambiguous submission and a symbol blocked silently and indefinitely.
STUCK_APPROVAL_ALERT_H=24
# How many minutes before our submission to search for candidate broker orders.
# Erring wide is safe: an extra candidate over-reserves (rejects a legitimate
# trade, recoverable); a missed one under-reserves (opens the ceiling, not).
RESOLVE_LOOKBACK_MIN=30

# Buys are always LIMIT orders, GTC, priced through the ask by
# APPROVAL_SLIPPAGE_BUFFER_PCT. There is no market-buy toggle: an unbounded
# market buy has no worst case for the guards to check against.
                                             # true  = GTC limit buy at the price shown on the recommendation embed.
                                             #         Caps what you pay, but if the price rose between the scan and
                                             #         your approval the order sits unfilled — and the position is
                                             #         still recorded on acknowledgement, so /reconcile will report it
                                             #         as a phantom until it fills or you cancel it.
                                             #         GTC is deliberate: schwab-py's equity_buy_limit defaults to DAY,
                                             #         which would silently expire on evening approvals.
                                             # No effect when DRY_RUN=true (dry-run trades always record as market).

# News provider (optional — free tier: 25 requests/day; get key at alphavantage.co)
# When set, Alpha Vantage NEWS_SENTIMENT is used instead of yfinance for headlines.
# Each headline includes a pre-scored sentiment label, e.g. "Fed cuts rates [Bullish, 0.72]"
# ALPHA_VANTAGE_API_KEY=your_key_here

# Logging (optional)
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR

# Database (optional)
DB_PATH=algo_trade.db
